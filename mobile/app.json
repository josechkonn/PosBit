{
  "expo": {
    "name": "PosBit Mobile",
    "slug": "posbit-mobile",
    "version": "0.1.22",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.posbit.mobile"
    },
    "android": {
      "package": "com.posbit.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090d16"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a PosBit usar la cámara para escanear códigos de barras de productos."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "af742774-428f-4bb8-b4eb-e6062836a2fd"
      }
    },
    "owner": "joseasdsa"
  }
}
